{
  "opencollection": "1.0.0",
  "info": {
    "name": "AIMLAPI AI/ML API Documentation API Key Management Models API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Models",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "AIMLAPI List Models",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://{{baseurl}}/models"
          },
          "docs": "Lists the currently available engines, and provides basic information about each one such as the owner and availability."
        }
      ]
    }
  ],
  "bundled": true
}